# Optional settings for the notification hook (.claude/hooks/notify.py).
# Copy this file to .env for your own reference, but note that Claude Code does NOT load .env files:
# the hook reads real environment variables. Set them in your shell, or put them into the "env" block of
# .claude/settings.local.json (gitignored). Never commit a real value.

# Slack incoming webhook. This URL is a secret. Leave empty to disable Slack messages.
SLACK_WEBHOOK_URL=

# Set to 0 to disable the desktop notification (used by the tests and CI). Default: enabled.
# INCIDENT_NOTIFY_DESKTOP=0
